---
// Plantilla común de todas las páginas: cabecera, pie, letras, colores y datos para Google
import '@fontsource/crimson-pro/600.css';
import '@fontsource/crimson-pro/600-italic.css';
import '@fontsource/figtree/400.css';
import '@fontsource/figtree/500.css';
import '@fontsource/figtree/600.css';
import '@fontsource/figtree/700.css';
import '@fontsource/shadows-into-light-two/400.css';
import '../estilos/tema.css';
import '../estilos/web.css';
import Cabecera from '../componentes/Cabecera.astro';
import Pie from '../componentes/Pie.astro';
import { SITIO } from '../datos/web.js';

const {
  titulo,
  descripcion,
  imagen = '/img/banner-iuki.jpg',
  tipo = 'website',
  datos = [],
  indexar = true,
  canonica = true
} = Astro.props;

const url = new URL(Astro.url.pathname, SITIO).href;
const imagenAbsoluta = imagen ? new URL(imagen, SITIO).href : '';
const json = (o) => JSON.stringify(o).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo}</title>
  {descripcion && <meta name="description" content={descripcion} />}
  {!indexar && <meta name="robots" content="noindex" />}
  {canonica && indexar && <link rel="canonical" href={url} />}
  <meta name="theme-color" content="#F5F4ED" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:site_name" content="IUKI" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:type" content={tipo} />
  <meta property="og:title" content={titulo} />
  {descripcion && <meta property="og:description" content={descripcion} />}
  <meta property="og:url" content={url} />
  {imagenAbsoluta && <meta property="og:image" content={imagenAbsoluta} />}
  <meta name="twitter:card" content="summary_large_image" />
  {datos.map((d) => <script type="application/ld+json" set:html={json(d)} />)}
  <slot name="cabeza" />
</head>
<body>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <Cabecera />
  <main id="contenido">
    <slot />
  </main>
  <Pie />
</body>
</html>
